extends layout
block content
  .w3-card-4
    header.w3-container.w3-teal
      h1 Lista de Filmes
    .w3-container
      table.w3-table-all
        tr
          th ID
          th Título
          th Ano
          th Nº Atores
          th Nº Géneros
        each f in lista
          tr
            td= f._id
            td
              a(href="/filmes/" + f._id)= f.title
            td= f.year
            td= f.numAtores
            td= f.numGeneros