extends layout
block content
  .w3-card-4
    header.w3-container.w3-indigo
      h1 Ator: #{a.nome}
    .w3-container
      p #[b ID:] #{a.id}
      h3 Filmes em que participou:
      ul
        each f in filmes
          li
            a(href="/filmes/" + f._id)= f.title
    footer.w3-container.w3-indigo
      address Gerado por Cinema-App [#[a(href="/atores") Voltar]]