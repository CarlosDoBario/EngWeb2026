extends layout
block content
  .w3-card-4
    header.w3-container.w3-blue
      h2 Detalhe: #{emd.nome ? emd.nome.primeiro : emd.pnome}
    .w3-container.w3-padding
      ul.w3-ul.w3-border
        li #[b ID:] #{emd.id}
        li #[b Data:] #{emd.dataEMD}
        li #[b Modalidade:] #{emd.modalidade}
        li #[b Clube:] #{emd.clube}
        li #[b Resultado:] #{ (emd.resultado === true || emd.resultado === 'on') ? "Apto" : "Não Apto"}
    footer.w3-container.w3-blue
      a.w3-btn.w3-white.w3-margin(href="/") Voltar