extends layout
block content
  .w3-card-4
    header.w3-container.w3-indigo
      h2= emd ? "Editar Registo" : "Novo Registo"
    form.w3-container.w3-padding(method="POST" action=emd ? `/emd/${emd.id}` : "/emd")
      .w3-row-padding
        .w3-half
          label Primeiro Nome
          input.w3-input.w3-border(type="text" name="pnome" value=emd ? (emd.nome ? emd.nome.primeiro : emd.pnome) : "" required)
        .w3-half
          label Último Nome
          input.w3-input.w3-border(type="text" name="unome" value=emd ? (emd.nome ? emd.nome.último : emd.unome) : "" required)
      
      label Modalidade
      input.w3-input.w3-border(type="text" name="modalidade" value=emd?emd.modalidade:"")
      
      label Idade
      input.w3-input.w3-border(type="number" name="idade" value=emd?emd.idade:"")

      br
      input.w3-check(type="checkbox" name="resultado" checked=(emd && (emd.resultado === true || emd.resultado === 'on')))
      label  Apto para Prática Desportiva
      
      .w3-margin-top
        button.w3-btn.w3-green(type="submit") Guardar Dados
        a.w3-btn.w3-red.w3-margin-left(href="/") Cancelar