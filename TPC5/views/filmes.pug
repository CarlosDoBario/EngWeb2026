extends layout
block content
  .w3-card-4
    header.w3-container.w3-teal
      h1 Lista de Filmes 
        .w3-right
          a.w3-button.w3-blue.w3-round.w3-small(href="/atores") Atores
          a.w3-button.w3-indigo.w3-round.w3-small.w3-margin-left(href="/generos") Géneros
    .w3-container
      table.w3-table-all.w3-margin-top
        tr
          th ID
          th Título
          th Ano
          th #Géneros
          th #Elenco
        each f in list
          tr
            td= f.id
            td: a(href=`/filmes/${f.id}`)= f.title
            td= f.year
            td= f.genres ? f.genres.length : 0
            td= f.cast ? f.cast.length : 0