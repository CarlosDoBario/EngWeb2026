extends layout
block content
  .w3-card-4
    header.w3-container.w3-teal
      h1= record.title
    .w3-container.w3-padding
      p #[b Ano:] #{record.year}
      p #[b Géneros:] 
        each g in (record.genres || [])
          a.w3-tag.w3-light-grey.w3-margin-right(href=`/generos/${g.replace(/ /g,"_")}`)= g
      p #[b Elenco:]
        ul.w3-ul.w3-border
          each a in (record.cast || [])
            li: a(href=`/atores/${a.replace(/ /g,"_")}` style="text-decoration:none")= a
    footer.w3-container.w3-teal
      a.w3-button.w3-white.w3-margin(href="/filmes") Voltar