extends layout

block content
  .w3-card-4
    header.w3-container.w3-pink
      h1.w3-left Lista de Géneros
      .w3-right.w3-padding-16
        a.w3-btn.w3-round.w3-white(href="/filmes") Filmes
        a.w3-btn.w3-round.w3-white.w3-margin-left(href="/atores") Atores

    .w3-container
      table.w3-table-all.w3-margin-top.w3-hoverable
        tr
          th Género
          th Número de Filmes
        each g in list
          tr
            td
              // O link usa o ID com underscores gerado no router
              a(href=`/generos/${g.id}` style="text-decoration:none")
                b= g.nome
            td= g.count
    
    footer.w3-container.w3-pink.w3-margin-top
      address Gerado por EngWeb2026 em #{date}
      a.w3-button.w3-black.w3-margin-top.w3-margin-bottom(href="/filmes") Voltar à Página Principal