extends layout

block content
  .w3-card-4
    header.w3-container.w3-pink
      h1 Género: #{nome}
    
    .w3-container.w3-padding-16
      h3 Filmes nesta categoria:
      ul.w3-ul.w3-card.w3-hoverable
        each f in list
          li
            a(href=`/filmes/${f.id}` style="text-decoration:none")
              b= f.title 
              span.w3-text-grey  (#{f.year})
    
    footer.w3-container.w3-pink
      a.w3-button.w3-white.w3-margin(href="/generos") Voltar à Lista de Géneros
      a.w3-button.w3-black.w3-margin(href="/filmes") Início