extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1 Detalhes da Reparação: #{r._id}
    
    .w3-container.w3-padding
      ul.w3-ul.w3-card-2.w3-white
        li #[b Nome do Cliente:] #{r.nome}
        li #[b NIF:] #{r.nif}
        li #[b Data:] #{r.data}
        li #[b Viatura:] #{r.viatura.marca} #{r.viatura.modelo} (#{r.viatura.matricula})
        li #[b Total de Intervenções:] #{r.nr_intervencoes}

      h3.w3-border-bottom.w3-border-teal.w3-text-teal Intervenções Realizadas
      table.w3-table-all.w3-hoverable
        thead
          tr.w3-light-grey
            th Código
            th Serviço
            th Descrição
        tbody
          each i in r.intervencoes
            tr
              td= i.codigo
              td= i.nome
              td= i.descricao

    footer.w3-container.w3-teal.w3-padding
      a.w3-button.w3-round-large.w3-white.w3-border(href="/") Voltar à Página Principal