extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1 Marca: #{marca}
    
    .w3-container.w3-padding
      h3 Modelos intervencionados:
      ul.w3-ul.w3-border.w3-light-grey
        each m in modelos
          li= m

      h3 Histórico de Reparações
      table.w3-table-all.w3-hoverable
        thead
          tr.w3-light-grey
            th ID
            th Data
            th Nome
            th Matrícula
            th Intervenções
        tbody
          each r in lista
            tr
              td
                a(href="/" + r._id)= r._id
              td= r.data
              td= r.nome
              td= r.viatura.matricula
              td= r.nr_intervencoes

    footer.w3-container.w3-teal.w3-padding
      a.w3-button.w3-round-large.w3-white.w3-border(href="/") Voltar à Página Principal